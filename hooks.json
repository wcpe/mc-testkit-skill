{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|edit|write|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${DEVIN_PLUGIN_ROOT:-${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}}/hooks/guard-mc-testkit.js\" ]; then node \"${DEVIN_PLUGIN_ROOT:-${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}}/hooks/guard-mc-testkit.js\"; fi"
          }
        ]
      }
    ]
  }
}